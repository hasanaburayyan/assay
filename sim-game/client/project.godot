; Assay — the Godot client (ASSA-7, step 6 of the minimal demo loop).
;
; A LOCKSTEP PEER, NEVER A SECOND RULES ENGINE (Decision 2, and principle 1 in
; the repo's CLAUDE.md). Everything in here reads world state and submits
; commands; no file under `scripts/` may decide a game rule.
;
; Config version 5 is Godot 4.x.

config_version=5

[application]

config/name="Assay"
config/description="The Assay client: a lockstep peer of sim-relay."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[network]

limits/tcp/connect_timeout_seconds=5

[rendering]

textures/canvas_textures/default_texture_filter=0

; Required to export macOS universal or arm64: Godot refuses the preset
; outright without it ("Cannot export for universal or arm64 if ETC2 ASTC
; texture format is disabled"). The client has no textures yet, so this costs
; nothing today; it has to be on before the first sprite arrives anyway.
textures/vram_compression/import_etc2_astc=true

[importer_defaults]

; PIXEL ART IMPORT DEFAULTS. These decide whether the sprites arrive crisp or
; mush, so they are pinned here rather than left to whatever each texture is
; imported with.
;
; Measured, not assumed: I imported head.png into this project with the stock
; settings and read the generated .import back. Two of the three were already
; right (compress/mode=0 lossless, mipmaps/generate=false). The third was not.
;
; detect_3d/compress_to defaults to 1. That is Godot's "detect 3D" feature:
; the first time a texture is touched in a 3D context, Godot SILENTLY
; re-imports it with VRAM block compression and turns mipmaps on, and
; rewrites the .import file behind you. Block compression on flat colours
; with hard edges is exactly the thing that ruins pixel art, and because it
; fires on use rather than on import it would show up as "the sprites went
; blurry at some point" long after whoever caused it moved on. 0 disables it.
;
; The other two are already stock, pinned so they cannot drift.
;
; Verified: with this block, a fresh import of head.png yields
; compress/mode=0, mipmaps/generate=false, detect_3d/compress_to=0.
;
; This pairs with default_texture_filter=0 above. That one makes a sprite
; sample crisply; these make sure the pixels are still there to sample.
texture={
"compress/mode": 0,
"detect_3d/compress_to": 0,
"mipmaps/generate": false
}

[debug]

; GDSCRIPT WARNINGS ARE ON, AND TWO OF THEM ARE ERRORS.
;
; Both promoted ones are always bugs, never style, and both are invisible to a
; green test suite. `unreachable_code` found a real one the day this was turned
; on: eight lines of `main.gd` that set the world/tick/hash line sat after a
; `return` (I stranded them inserting a function into the middle of `_refresh`),
; so that line never updated on a running client and 79 passing tests had no
; opinion about it. `standalone_expression` is the other shape of the same
; mistake -- `a == b` written where `a = b` was meant does nothing, loudly.
;
; Error level means THE ENGINE REFUSES TO LOAD THE SCRIPT, which is what makes
; it a gate: Godot exits 0 on a parse error, so `tools/check_every_script.sh`
; compiles every .gd file and greps, including the ones nothing instantiates.
gdscript/warnings/enable=true
gdscript/warnings/unreachable_code=2
gdscript/warnings/standalone_expression=2
